{
  "$description": ".describe( design tokens. The one source for colour, type, space, form and motion. Edit this file, then run `python3 tokens/build.py`; never edit tokens/dist/ by hand. A token with `$extensions.mode.dark` takes that value in dark mode; dark is a separate environment, not an inversion.",

  "color": {
    "$type": "color",

    "brand": {
      "$description": "The eight palette colours. Primitives: use the semantic roles below in work, not these directly.",
      "navy":       { "$value": "#092052", "$description": "Structure, typography, dark surfaces" },
      "blue":       { "$value": "#0F58E5", "$description": "Active, computational, directional" },
      "coral":      { "$value": "#E5484D", "$description": "Genuine outliers only" },
      "grey":       { "$value": "#64748B", "$description": "Instrument body; does most of the work" },
      "light-grey": { "$value": "#CBD5E1", "$description": "Construction, grids, inactive" },
      "off-white":  { "$value": "#F6F8FC", "$description": "Light ground" },
      "deep-red":   { "$value": "#8C1D1D", "$description": "Negative values only" },
      "green":      { "$value": "#0F7B3D", "$description": "Positive deltas only" }
    },

    "surface": {
      "ground": { "$value": "#F6F8FC", "$extensions": { "mode": { "dark": "#050F2E" } }, "$description": "The page" },
      "panel":  { "$value": "#FFFFFF", "$extensions": { "mode": { "dark": "#081A40" } }, "$description": "Plates, cards, chart surfaces" },
      "field":  { "$value": "#FFFFFF", "$extensions": { "mode": { "dark": "#0A1F4C" } }, "$description": "Inputs" }
    },

    "text": {
      "ink":        { "$value": "#092052", "$extensions": { "mode": { "dark": "#F6F8FC" } }, "$description": "Headlines, primary text, the default" },
      "body":       { "$value": "#5A6B85", "$extensions": { "mode": { "dark": "#9FB0CC" } }, "$description": "Running text and secondary copy" },
      "dim":        { "$value": "#63738D", "$extensions": { "mode": { "dark": "#788BAC" } }, "$description": "Captions, source lines, placeholders. The lowest text tier: 4.5:1 on every surface" },
      "active-ink": { "$value": "#FFFFFF", "$extensions": { "mode": { "dark": "#050F2E" } }, "$description": "Text on an active (blue) fill" }
    },

    "line": {
      "faint": { "$value": "#CBD5E1", "$extensions": { "mode": { "dark": "#1C3566" } }, "$description": "Construction lines, inactive marks, decorative geometry. Never carries information" },
      "rule":  { "$value": "#D8E1EF", "$extensions": { "mode": { "dark": "#16346E" } }, "$description": "Hairlines, borders, chart grids" }
    },

    "role": {
      "active": { "$value": "#0F58E5", "$extensions": { "mode": { "dark": "#5B8DF0" } }, "$description": "Live, selected, in progress, the one primary action, links" },
      "mark":   { "$value": "#E5484D", "$extensions": { "mode": { "dark": "#F0696D" } }, "$description": "A data outlier under a named test. Nowhere else; never text, never an error, never an accent" },
      "neg":    { "$value": "#8C1D1D", "$extensions": { "mode": { "dark": "#E0736F" } }, "$description": "A value that moved the bad way, or an action that failed" },
      "pos":    { "$value": "#0F7B3D", "$extensions": { "mode": { "dark": "#3FBE77" } }, "$description": "A value that moved the good way, or an action that completed" }
    },

    "viz": {
      "$description": "Data-visualisation colours. Read charts/CHARTS.md first: the default chart is one story series in blue against grey context.",
      "story":   { "$value": "#0F58E5", "$extensions": { "mode": { "dark": "#5B8DF0" } }, "$description": "The one series the finding is about" },
      "context": { "$value": "#64748B", "$extensions": { "mode": { "dark": "#676A70" } }, "$description": "Every other series. Neutral grey in dark mode; blue-greys fail against the dark story blue" },
      "band-opacity": { "$type": "number", "$value": 0.12, "$description": "Confidence bands: the series colour at this opacity, no edge" },

      "cat": {
        "$description": "Categorical: identity when several series are all named and none is the story. Assign in this order, never cycled, never skipped. Coral, red and green are excluded so outliers and status never look like a series. Lines, bars and stacks may use all six; scatter, maps and small multiples use the first three only (the all-pairs test caps them there). A seventh series folds into Other or facets.",
        "1": { "$value": "#0F58E5", "$extensions": { "mode": { "dark": "#5B8DF0" }, "name": "blue" } },
        "2": { "$value": "#0E9488", "$extensions": { "mode": { "dark": "#20A89B" }, "name": "verdigris" } },
        "3": { "$value": "#916508", "$extensions": { "mode": { "dark": "#AD7C1D" }, "name": "brass" } },
        "4": { "$value": "#7E3593", "$extensions": { "mode": { "dark": "#974DAD" }, "name": "plum" } },
        "5": { "$value": "#648026", "$extensions": { "mode": { "dark": "#76923B" }, "name": "moss" } },
        "6": { "$value": "#218CB5", "$extensions": { "mode": { "dark": "#3A9EC8" }, "name": "sky" } }
      },

      "seq": {
        "$description": "Sequential: magnitude, light to dark, one hue. Step 500 is the brand blue. In dark mode the scale reverses (700 is near zero) so small values recede into the surface.",
        "100": { "$value": "#E6EFFF" },
        "200": { "$value": "#C4D8FD" },
        "300": { "$value": "#98BBFB" },
        "400": { "$value": "#6095FA" },
        "500": { "$value": "#0F58E5" },
        "600": { "$value": "#0A41AD" },
        "700": { "$value": "#0A2F77" }
      },

      "seq-alt": {
        "$description": "A second sequential scale, brass, for when two magnitudes share a view. Never mix it into the blue scale.",
        "100": { "$value": "#FAEDD9" },
        "200": { "$value": "#EED3AC" },
        "300": { "$value": "#DBB477" },
        "400": { "$value": "#BF8F3C" },
        "500": { "$value": "#895F04" },
        "600": { "$value": "#674603" },
        "700": { "$value": "#483000" }
      },

      "div": {
        "$description": "Diverging: polarity around a meaningful zero (vs. target, vs. last year, z-scores). Brass below, blue above, neutral grey at zero; equal lightness per step on both arms. It is not good/bad: when the sides mean good and bad, use role.pos and role.neg.",
        "n5": { "$value": "#755002", "$extensions": { "mode": { "dark": "#F9B73F" } } },
        "n4": { "$value": "#996A06", "$extensions": { "mode": { "dark": "#D19936" } } },
        "n3": { "$value": "#B7893B", "$extensions": { "mode": { "dark": "#AA7D2D" } } },
        "n2": { "$value": "#CDAB76", "$extensions": { "mode": { "dark": "#82632F" } } },
        "n1": { "$value": "#E3CEAD", "$extensions": { "mode": { "dark": "#5C4A2D" } } },
        "0":  { "$value": "#EEEEEE", "$extensions": { "mode": { "dark": "#353535" } } },
        "p1": { "$value": "#BFD2F3", "$extensions": { "mode": { "dark": "#3E4D69" } } },
        "p2": { "$value": "#96B2E5", "$extensions": { "mode": { "dark": "#4F6997" } } },
        "p3": { "$value": "#6D92D6", "$extensions": { "mode": { "dark": "#6185C8" } } },
        "p4": { "$value": "#4972C0", "$extensions": { "mode": { "dark": "#77A4F6" } } },
        "p5": { "$value": "#2552AA", "$extensions": { "mode": { "dark": "#A5C5FF" } } }
      }
    }
  },

  "font": {
    "$type": "fontFamily",
    "serif":      { "$value": ["Fraunces", "Iowan Old Style", "Georgia", "serif"], "$description": "Meaning: headlines, statements, hero numbers. Weight 300, 'SOFT' 0, 'WONK' 0" },
    "sans":       { "$value": ["Readex Pro", "system-ui", "-apple-system", "sans-serif"], "$description": "Explanation: body, interface, annotations" },
    "ar-sans":    { "$value": ["Vazirmatn", "IBM Plex Sans Arabic", "system-ui", "sans-serif"], "$description": "Arabic body and interface" },
    "mono":       { "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "Measurement: numerals and short labels only (the mono budget)" },
    "display-alt": { "$value": ["Prata", "Georgia", "serif"], "$description": "Covers and posters, 40px and up only" },
    "ar-display": { "$value": ["Amiri", "serif"], "$description": "Arabic headings" },
    "ar-label":   { "$value": ["Reem Kufi", "sans-serif"], "$description": "Short Arabic labels" }
  },

  "type": {
    "$description": "One scale, base x ratio. The ratios are fixed; each medium sets its own base. `px` for screens, `pt` for print.",
    "ratio": {
      "$type": "number",
      "display": { "$value": 5.5 },
      "opener":  { "$value": 3.5 },
      "h2":      { "$value": 2.5 },
      "h3":      { "$value": 1.75 },
      "lede":    { "$value": 1.3125 },
      "body":    { "$value": 1 },
      "meta":    { "$value": 0.6875 }
    },
    "base": {
      "$description": "Body size per medium. Social is measured off the October 2026 LinkedIn set: 32 gives labels 22, headlines 80 and openers 112, which is what those posts use.",
      "web":    { "$type": "dimension", "$value": "16px", "$description": "Website and data apps" },
      "slides": { "$type": "dimension", "$value": "28px", "$description": "1920 x 1080 decks" },
      "social": { "$type": "dimension", "$value": "32px", "$description": "1080 x 1350 and 1080 x 1080 posts" },
      "report": { "$type": "dimension", "$value": "10pt", "$description": "A4 print and PDF reports" }
    },
    "line-height": {
      "$type": "number",
      "display": { "$value": 0.95 },
      "opener":  { "$value": 1.0 },
      "h2":      { "$value": 1.06 },
      "h3":      { "$value": 1.14 },
      "lede":    { "$value": 1.5 },
      "body":    { "$value": 1.62 },
      "meta":    { "$value": 1.4 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.032em" },
      "opener":  { "$value": "-0.028em" },
      "h2":      { "$value": "-0.022em" },
      "h3":      { "$value": "-0.016em" },
      "body":    { "$value": "0" },
      "meta":    { "$value": "0.12em", "$description": "Latin only; Arabic is never tracked" }
    },
    "weight": {
      "$type": "fontWeight",
      "display": { "$value": 300 },
      "body":    { "$value": 300 },
      "body-em": { "$value": 500 },
      "meta":    { "$value": 500 }
    },
    "arabic": {
      "$type": "number",
      "$description": "Arabic optical compensation, measured in type/specimen.html. Open item: the value inside each bracket was set by eye.",
      "scale":       { "$value": 1.15, "$description": "Arabic display against Fraunces" },
      "body-scale":  { "$value": 1.2, "$description": "Vazirmatn body against Readex Pro" },
      "lh-display":  { "$value": 1.5 },
      "lh-body":     { "$value": 1.85 },
      "w-body":      { "$type": "fontWeight", "$value": 300 },
      "w-em":        { "$type": "fontWeight", "$value": 500 }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "Multiples of 4, which is 2u of the geometry's stroke unit. Scale with the medium's type base (x1.75 slides, x2 social) so proportions hold.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" }
  },

  "radius": {
    "$type": "dimension",
    "control": { "$value": "2px", "$description": "Buttons, fields: machined, not rounded" },
    "panel":   { "$value": "0px", "$description": "Panels are instrument plates: no radius" },
    "bar-end": { "$value": "4px", "$description": "The data end of a bar; the baseline end stays square" }
  },

  "stroke": {
    "$type": "dimension",
    "hair":     { "$value": "1px", "$description": "Rules, grids, axes, leaders" },
    "context":  { "$value": "1.25px", "$description": "Context lines, reference rules" },
    "data":     { "$value": "2px", "$description": "The story line" },
    "icon":     { "$value": "1.5px", "$description": "Icons, on the 24 grid" },
    "dot":      { "$value": "4px", "$description": "Data dot radius (8px across), with a 2px surface ring" }
  },

  "size": {
    "$type": "dimension",
    "control":    { "$value": "40px" },
    "control-sm": { "$value": "32px" },
    "hit":        { "$value": "24px", "$description": "Minimum hover and focus target on a chart mark" },
    "bar-max":    { "$value": "24px", "$description": "Maximum bar thickness" }
  },

  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1], "$description": "One curve for everything that settles. No overshoot, no spring" },
    "t1": { "$type": "duration", "$value": "120ms" },
    "t2": { "$type": "duration", "$value": "220ms" },
    "t3": { "$type": "duration", "$value": "420ms" }
  },

  "shadow": {
    "elev": { "$type": "shadow", "$value": "0 1px 0 rgba(9,32,82,.04), 0 8px 24px -12px rgba(9,32,82,.22)", "$extensions": { "mode": { "dark": "0 1px 0 rgba(0,0,0,.2), 0 10px 30px -12px rgba(0,0,0,.6)" } }, "$description": "The only shadow, for floating layers (menus, toasts). Panels never cast one" }
  }
}
